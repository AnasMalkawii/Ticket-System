# Keep API and frontend on the same browser origin, including in production.
VITE_API_BASE_URL=/api/v1
# Development only: Vite forwards /api to this Spring Boot server.
API_PROXY_TARGET=http://localhost:8080
# Optional override: defaults to ticket_csrf in development and __Host-ticket_csrf in production.
# VITE_CSRF_COOKIE_NAME=__Host-ticket_csrf
